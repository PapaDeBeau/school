# Copy this file to .env.production on the server only. Never commit .env.production.
#
# IMPORTANT: Use the existing production values when moving the current live app.
# Changing CANVAS_TOKEN_WRAP_KEY would make the already-encrypted Canvas token
# unreadable. Changing FAMILY_AUTH_SIGNING_KEY would sign everyone out.

NODE_ENV=production
PORT=3000

# Existing Worker secrets — copy their existing production values during cutover.
CANVAS_TOKEN_WRAP_KEY=replace-with-the-existing-32-byte-base64url-production-key
FAMILY_AUTH_SIGNING_KEY=replace-with-the-existing-production-signing-key
BEAU_PROXY_ACCESS_KEY=replace-with-a-long-random-proxy-key

# JSON only; keep it on one line in the real .env.production file.
# The pinHash values must be HMAC-SHA-256 values created with FAMILY_AUTH_SIGNING_KEY.
FAMILY_AUTH_USERS={"beau":{"displayName":"Beau","pinHash":"replace-with-existing-hash"},"cathy":{"displayName":"Cathy","pinHash":"replace-with-existing-hash"},"mom":{"displayName":"Mom","pinHash":"replace-with-existing-hash"},"dad":{"displayName":"Dad","pinHash":"replace-with-existing-hash"}}

# Reserved for the VPS/MySQL migration. The current live app uses Cloudflare D1,
# so this value has no effect until the D1 data layer is migrated to MySQL.
DATABASE_URL=mysql://school_app:replace-password@localhost:3306/beauvizenor_school
